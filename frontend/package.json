{
  "name": "hawkins-nitro-run-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "npm run typecheck && npm run test:physics && npm run test:collision && npm run test:geometry && npm run test:race && npm run test:states && npm run test:input && npm run test:scene",
    "test:physics": "node --experimental-transform-types --no-warnings --import ./tools/register.mjs tools/physics.ts",
    "test:collision": "node --experimental-transform-types --no-warnings --import ./tools/register.mjs tools/wallCollision.ts",
    "test:geometry": "node --experimental-transform-types --no-warnings --import ./tools/register.mjs tools/geometryTest.ts",
    "test:race": "node --experimental-transform-types --no-warnings --import ./tools/register.mjs tools/raceSim.ts",
    "test:states": "node --experimental-transform-types --no-warnings --import ./tools/register.mjs tools/raceStates.ts",
    "test:input": "node --experimental-transform-types --no-warnings --import ./tools/register.mjs tools/inputProbe.ts",
    "test:scene": "node --experimental-transform-types --no-warnings --import ./tools/register.mjs tools/sceneProbe.ts"
  },
  "dependencies": {
    "jimp": "^1.6.1",
    "phaser": "^3.90.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9",
    "vite": "^8.3.1"
  }
}
