# ---------------------------------------------------------------------------
# HAWKINS: NITRO RUN - frontend environment
#
# Copy to .env and edit:
#   cd frontend
#   copy .env.example .env
#
# .env is gitignored. Only this template is committed.
#
# ---------------------------------------------------------------------------
# NEVER put a secret in this file or any other VITE_* variable.
#
# Everything prefixed VITE_ is inlined into the JavaScript bundle and is
# therefore visible to anyone who opens the page. There are no secrets on the
# frontend because there is nothing secret to hold: the API is unauthenticated
# and the database is never contacted from the browser.
#
# The MySQL credentials live in backend/.env and never leave the server.
# ---------------------------------------------------------------------------

# Base URL of the Spring Boot API. No trailing slash.
#
# The dev default matches the backend's port and the CORS origins configured in
# backend/src/main/resources/application-dev.yml.
VITE_API_BASE_URL=http://localhost:8080