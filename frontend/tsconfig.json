{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"],
  // `src/game/highway` is an in-progress pseudo-3D highway module that is not
  // wired into the game and imports a `HIGHWAY*` config block that does not
  // exist. It is left on disk untouched, but excluded here so it cannot fail the
  // build for the game that does ship.
  "exclude": ["src/game/highway"]
}
