# ---------------------------------------------------------------------------
# Template for local backend configuration. Copy to .env and fill in real
# values:
#
#   cd backend
#   copy .env.example .env      (PowerShell)
#
# .env is gitignored and must never be committed. This file holds NO real
# secrets; every value below is a placeholder.
#
# scripts/run-backend.ps1 reads .env automatically, so with a .env in place you
# can just run it with no further setup.
# ---------------------------------------------------------------------------

# JDBC URL.
#
#   useSSL=false + allowPublicKeyRetrieval=true are required for MySQL 8's
#   default caching_sha2_password against a local, unencrypted server. For a
#   remote or production database, use a TLS URL instead and drop
#   allowPublicKeyRetrieval.
#
#   serverTimezone=UTC keeps timestamps aligned with the JVM, which is pinned
#   to UTC in application.yml.
DB_URL=jdbc:mysql://127.0.0.1:3306/hawkins_nitro_run?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# A dedicated MySQL account, NOT root.
#
# Create it with rights on the game schemas only:
#
#   CREATE USER 'hawkins_app'@'localhost' IDENTIFIED BY '<choose-a-strong-password>';
#   CREATE USER 'hawkins_app'@'127.0.0.1' IDENTIFIED BY '<choose-a-strong-password>';
#   GRANT ALL PRIVILEGES ON hawkins_nitro_run.*      TO 'hawkins_app'@'localhost';
#   GRANT ALL PRIVILEGES ON hawkins_nitro_run.*      TO 'hawkins_app'@'127.0.0.1';
#   GRANT ALL PRIVILEGES ON hawkins_nitro_run_test.* TO 'hawkins_app'@'localhost';
#   GRANT ALL PRIVILEGES ON hawkins_nitro_run_test.* TO 'hawkins_app'@'127.0.0.1';
#   FLUSH PRIVILEGES;
#
# Flyway needs DDL rights on the schema, so this account can create and alter
# tables inside hawkins_nitro_run only. It has no global privileges and cannot
# create users or databases.
DB_USERNAME=hawkins_app
DB_PASSWORD=change-me

# Optional.
# SERVER_PORT=8080
# APP_VERSION=0.5.0-phase5
# CORS_ALLOWED_ORIGINS=https://your-frontend.example