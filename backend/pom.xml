<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.3</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.hawkins</groupId>
	<artifactId>nitro-run</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>nitro-run</name>
	<description>Hawkins Nitro Run backend</description>

	<properties>
		<!--
			Java 21. Spring Boot 3.5 supports 17..24, and 21 is an LTS release, so
			this is the version to target rather than the 17 floor.
		-->
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!--
			Phase 5: MySQL persistence.

			The application refuses to start without a reachable database. That is
			the intended trade; a game that silently loses every leaderboard
			entry on restart is worse than one that refuses to boot.

			Flyway owns the schema. Hibernate is set to `validate`, never
			`create` or `update`, so the application can never alter production
			tables behind the migrations' back.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
			Schema migrations. `flyway-mysql` is a separate module as of Flyway 10;
			without it Flyway cannot see MySQL at all.
		-->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-mysql</artifactId>
		</dependency>

		<!--
			Security. Phase 7 added this because until now every endpoint was
			reachable by anyone: a caller could enumerate every player profile
			and submit a race for any player id.

			BCryptPasswordEncoder ships inside spring-security-crypto, which
			starter-security pulls in, so password hashing costs no extra
			dependency.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!--
			Actuator for health and monitoring. Only the health endpoint is exposed;
			see `management.endpoints.web.exposure.include` in application.yml.
			The richer ones (env, beans, configprops) can leak configuration and
			so stay closed in every profile.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>